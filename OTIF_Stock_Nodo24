<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OTIF Stock Nodo 24</title>
<style>
:root{--navy:#17365d;--blue:#2563eb;--sky:#dbeafe;--green:#15803d;--greenbg:#dcfce7;--orange:#c2410c;--orangebg:#ffedd5;--red:#b91c1c;--redbg:#fee2e2;--gray:#64748b;--light:#f8fafc;--line:#e2e8f0;--ink:#0f172a;--purple:#7e22ce;--purplebg:#f3e8ff}
*{box-sizing:border-box} body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:#f1f5f9;color:var(--ink)}
header{background:linear-gradient(135deg,#102a4d,#1d4f7a);color:#fff;padding:28px 24px;box-shadow:0 4px 16px #0f172a33}
.header-inner{max-width:1400px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
h1{margin:0;font-size:clamp(1.7rem,3vw,2.5rem)} header p{margin:7px 0 0;color:#dbeafe}.badge{background:#ffffff22;border:1px solid #ffffff44;padding:8px 12px;border-radius:999px;font-weight:700}
main{max-width:1400px;margin:22px auto;padding:0 18px 48px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.tab{border:0;background:#fff;color:#334155;padding:11px 15px;border-radius:10px;cursor:pointer;font-weight:700;box-shadow:0 1px 4px #0f172a14}.tab.active{background:var(--navy);color:#fff}.panel{display:none}.panel.active{display:block}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 6px 18px #0f172a0d;margin-bottom:18px}.card h2,.card h3{margin-top:0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}.kpi{padding:16px;border-radius:14px;background:#fff;border-left:5px solid var(--blue);box-shadow:0 3px 12px #0f172a12}.kpi small{display:block;color:var(--gray);font-weight:700}.kpi strong{display:block;font-size:1.8rem;margin-top:5px}.kpi.red{border-color:var(--red)}.kpi.green{border-color:var(--green)}.kpi.orange{border-color:var(--orange)}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{border-collapse:collapse;width:100%;min-width:760px}th{background:var(--navy);color:#fff;padding:11px 9px;text-align:center;position:sticky;top:0}td{padding:9px;border-bottom:1px solid var(--line);text-align:center}tr:hover td{background:#f8fafc}input,select{width:100%;min-width:76px;border:1px solid #cbd5e1;border-radius:8px;padding:8px;font:inherit;text-align:center;background:#eff6ff;color:#1d4ed8;font-weight:600}input:focus,select:focus{outline:3px solid #93c5fd66;border-color:#3b82f6}.btns{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}.btn{border:0;border-radius:10px;padding:11px 15px;font-weight:700;cursor:pointer}.primary{background:var(--blue);color:#fff}.secondary{background:#e2e8f0;color:#172554}.success{background:var(--green);color:#fff}.danger{background:var(--red);color:#fff}.btn:hover{filter:brightness(.96);transform:translateY(-1px)}
.alert{padding:12px 14px;border-radius:10px;margin:8px 0}.alert.red{background:var(--redbg);color:#7f1d1d}.alert.orange{background:var(--orangebg);color:#7c2d12}.alert.green{background:var(--greenbg);color:#14532d}.note{background:#eff6ff;border-left:4px solid var(--blue);padding:12px 14px;border-radius:8px;color:#1e3a8a}.formula{font-family:Consolas,monospace;background:#0f172a;color:#dbeafe;padding:10px;border-radius:8px;overflow:auto}.status{font-size:.78rem;font-weight:800;padding:5px 8px;border-radius:999px;display:inline-block}.status.ok{background:var(--greenbg);color:var(--green)}.status.warn{background:var(--orangebg);color:var(--orange)}.status.bad{background:var(--redbg);color:var(--red)}
.chart-box{height:360px;border:1px solid var(--line);border-radius:12px;padding:10px;background:#fff}.chart-box canvas{width:100%;height:100%}.legend{display:flex;gap:16px;flex-wrap:wrap;margin:8px 0}.dot{width:11px;height:11px;border-radius:2px;display:inline-block;margin-right:6px}.mrp-block{margin-bottom:20px}.mrp-title{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.footer{text-align:center;color:var(--gray);padding:30px;font-size:.9rem}.hidden{display:none}@media(max-width:700px){header{padding:22px 16px}.card{padding:13px}.tab{flex:1}.chart-box{height:280px}}
@media print{header,.tabs,.btns,.footer{display:none!important}main{max-width:none;margin:0;padding:0}.panel{display:block!important}.card{box-shadow:none;break-inside:avoid}.chart-box{height:260px}}
</style>
</head>
<body>
<header><div class="header-inner"><div><h1>OTIF Stock Nodo 24</h1><p>Simulación, planificación y control de stock de elementos de protección personal</p></div><div class="badge">OTIF Stock · Simulación</div></div></header>
<main>
<nav class="tabs">
<button class="tab active" data-tab="dashboard">Panel</button><button class="tab" data-tab="mps">MPS</button><button class="tab" data-tab="bom">Artículos y parámetros</button><button class="tab" data-tab="mrp">Cálculo MRP</button><button class="tab" data-tab="orders">Órdenes</button><button class="tab" data-tab="help">Guía</button>
</nav>
<section id="dashboard" class="panel active">
<div class="grid" id="kpis"></div>
<div class="card"><div class="mrp-title"><div><h2>Escenarios de simulación</h2><p>Aplicá un factor sobre el Programa Maestro de Producción.</p></div><div style="min-width:220px"><select id="scenario"><option value="1">Demanda habitual</option><option value="1.15">Demanda +15%</option><option value="1.30">Demanda +30%</option><option value="0.85">Demanda -15%</option></select></div></div><div class="btns"><button class="btn primary" onclick="applyScenario()">Aplicar escenario</button><button class="btn secondary" onclick="resetAll()">Restablecer datos</button><button class="btn success" onclick="window.print()">Imprimir informe</button></div></div>
<div class="card"><h2>Reposiciones planificadas por semana</h2><div class="legend" id="legend"></div><div class="chart-box"><canvas id="ordersChart"></canvas></div></div>
<div class="card"><h2>Alertas de planificación</h2><div id="alerts"></div></div>
</section>
<section id="mps" class="panel"><div class="card"><h2>Programa Maestro de Producción</h2><p>Ingresá la cantidad de kits de entrega de EPP requeridos por semana.</p><div class="table-wrap"><table><thead><tr><th>Producto terminado</th><th>Unidad</th><th>Stock inicial</th><th>Semana 1</th><th>Semana 2</th><th>Semana 3</th><th>Semana 4</th><th>Semana 5</th><th>Semana 6</th></tr></thead><tbody><tr><td><b>Kit de EPP</b></td><td>unidad</td><td><input id="fgStock" type="number" min="0" value="20"></td><td><input class="mps" type="number" min="0" value="100"></td><td><input class="mps" type="number" min="0" value="150"></td><td><input class="mps" type="number" min="0" value="120"></td><td><input class="mps" type="number" min="0" value="180"></td><td><input class="mps" type="number" min="0" value="140"></td><td><input class="mps" type="number" min="0" value="160"></td></tr></tbody></table></div><div class="btns"><button class="btn primary" onclick="calculate()">Ejecutar MRP</button></div><div class="note">La demanda semanal del kit de EPP determina el consumo previsto de cada componente. Los valores pueden modificarse para simular distintos escenarios de entrega y reposición.</div></div></section>
<section id="bom" class="panel"><div class="card"><h2>Artículos y parámetros de stock</h2><div class="table-wrap"><table id="bomTable"><thead><tr><th>Código</th><th>Componente</th><th>Consumo por kit</th><th>Inventario inicial</th><th>Lead time</th><th>Lote mínimo</th><th>Stock seguridad</th><th>Recepción S1</th><th>Acción</th></tr></thead><tbody></tbody></table></div><div class="btns"><button class="btn primary" onclick="addMaterial()">Agregar material</button><button class="btn success" onclick="calculate()">Guardar y calcular</button></div></div></section>
<section id="mrp" class="panel"><div class="card"><h2>Cálculo MRP por componente</h2><div id="mrpResults"></div></div></section>
<section id="orders" class="panel"><div class="card"><h2>Reposiciones planificadas</h2><div class="table-wrap"><table id="ordersTable"><thead><tr><th>Componente</th><th>S1</th><th>S2</th><th>S3</th><th>S4</th><th>S5</th><th>S6</th><th>Total</th></tr></thead><tbody></tbody></table></div><div class="btns"><button class="btn primary" onclick="downloadCSV()">Descargar CSV</button><button class="btn secondary" onclick="saveLocal()">Guardar escenario</button><button class="btn secondary" onclick="loadLocal()">Recuperar escenario</button></div></div><div class="card"><h2>Reposiciones urgentes</h2><div id="urgentOrders"></div></div></section>
<section id="help" class="panel"><div class="card"><h2>Cómo usar el laboratorio</h2><ol><li>Definí el MPS semanal.</li><li>Revisá la artículos, inventario, lead time, lote y stock de seguridad.</li><li>Ejecutá el cálculo.</li><li>Analizá necesidades netas, inventario proyectado y órdenes.</li><li>Revisá las órdenes urgentes y confirmá los datos antes de comprar.</li></ol><h3>Lógica aplicada</h3><div class="formula">Necesidad bruta = MPS × cantidad por kit</div><br><div class="formula">Necesidad neta = max(0, necesidad bruta + stock de seguridad − inventario anterior − recepción programada)</div><br><div class="formula">Recepción planificada = necesidad neta redondeada al lote mínimo</div><br><div class="formula">Liberación planificada = recepción planificada desplazada hacia atrás por el lead time</div><p class="note">Alcance: simulador didáctico de control de stock. Calcula consumos, necesidades netas y reposiciones planificadas. No reemplaza la verificación física ni la aprobación de compras.</p></div></section>
</main><div class="footer">Nodo 24 · OTIF Stock · Simulación académica</div>
<script>
const WEEKS=6;
const DEFAULTS=[
 {code:'4000000218',name:'GUANTE-TIPO A-VAQUETA-PUÑO LARGO',usage:1,stock:120,lead:1,lot:20,safety:20,scheduled:[0,0,0,0,0,0]},
 {code:'4000000034',name:'CASCO SEG S/FASTRAC BLANCO T1-CB',usage:1,stock:80,lead:2,lot:10,safety:15,scheduled:[0,0,0,0,0,0]},
 {code:'4000021374',name:'CAMISA TRABAJO ALG/MEZCLILL GRIS T.44',usage:1,stock:60,lead:2,lot:10,safety:10,scheduled:[0,0,0,0,0,0]},
 {code:'4000021393',name:'PANTALON TRABAJO ALG/MEZCLILL AZUL T.44',usage:1,stock:60,lead:2,lot:10,safety:10,scheduled:[0,0,0,0,0,0]},
 {code:'4000018587',name:'BOTIN USO GENERAL PREMIUM T/42',usage:1,stock:50,lead:3,lot:10,safety:10,scheduled:[0,0,0,0,0,0]}
];
let materials=JSON.parse(JSON.stringify(DEFAULTS)); let results={}; let urgents=[]; const colors=['#2563eb','#db2777','#0f9ca4','#7e22ce','#ea580c','#15803d'];
const n=v=>Math.max(0,Number(v)||0); const fmt=v=>new Intl.NumberFormat('es-AR').format(v);
function renderBOM(){const tb=document.querySelector('#bomTable tbody');tb.innerHTML='';materials.forEach((m,i)=>{tb.insertAdjacentHTML('beforeend',`<tr><td><input value="${m.code}" onchange="materials[${i}].code=this.value"></td><td><input value="${m.name}" onchange="materials[${i}].name=this.value"></td><td><input type="number" min="0" value="${m.usage}" onchange="materials[${i}].usage=n(this.value)"></td><td><input type="number" min="0" value="${m.stock}" onchange="materials[${i}].stock=n(this.value)"></td><td><input type="number" min="0" value="${m.lead}" onchange="materials[${i}].lead=n(this.value)"></td><td><input type="number" min="1" value="${m.lot}" onchange="materials[${i}].lot=Math.max(1,n(this.value))"></td><td><input type="number" min="0" value="${m.safety}" onchange="materials[${i}].safety=n(this.value)"></td><td><input type="number" min="0" value="${m.scheduled[0]}" onchange="materials[${i}].scheduled[0]=n(this.value)"></td><td><button class="btn danger" onclick="removeMaterial(${i})">Eliminar</button></td></tr>`)});}
function addMaterial(){materials.push({code:'MAT-'+(materials.length+1),name:'Nuevo material',usage:1,stock:0,lead:1,lot:100,safety:0,scheduled:Array(WEEKS).fill(0)});renderBOM()}
function removeMaterial(i){materials.splice(i,1);renderBOM();calculate()}
function roundLot(q,lot){return q<=0?0:Math.ceil(q/lot)*lot}
function calculate(){const mps=[...document.querySelectorAll('.mps')].map(x=>n(x.value));results={};urgents=[];materials.forEach((m)=>{let gross=[],sched=[...m.scheduled],pab=[],net=[],receipt=[],release=Array(WEEKS).fill(0),available=m.stock;for(let t=0;t<WEEKS;t++){gross[t]=mps[t]*m.usage;net[t]=Math.max(0,gross[t]+m.safety-available-sched[t]);receipt[t]=roundLot(net[t],m.lot);pab[t]=Math.max(0,available+sched[t]+receipt[t]-gross[t]);if(receipt[t]>0){const r=t-m.lead;if(r>=0)release[r]+=receipt[t];else urgents.push({material:m.name,qty:receipt[t],week:t+1,lead:m.lead})}available=pab[t]}results[m.name]={gross,sched,pab,net,receipt,release};});renderAll();}
function renderAll(){renderKPIs();renderAlerts();renderMRP();renderOrders();drawChart()}
function renderKPIs(){const totalMps=[...document.querySelectorAll('.mps')].reduce((a,x)=>a+n(x.value),0);let orders=0,units=0;Object.values(results).forEach(r=>r.release.forEach(v=>{if(v>0)orders++;units+=v}));document.getElementById('kpis').innerHTML=`<div class="kpi"><small>Kits de EPP planificados</small><strong>${fmt(totalMps)}</strong></div><div class="kpi green"><small>Artículos controlados</small><strong>${materials.length}</strong></div><div class="kpi orange"><small>Reposiciones a emitir</small><strong>${orders}</strong></div><div class="kpi"><small>Unidades a reponer</small><strong>${fmt(units)}</strong></div><div class="kpi red"><small>Reposiciones urgentes</small><strong>${urgents.length}</strong></div>`}
function renderAlerts(){const el=document.getElementById('alerts');if(!urgents.length){el.innerHTML='<div class="alert green"><b>Planificación cubierta.</b> No se detectaron órdenes anteriores al horizonte.</div>';return}el.innerHTML='<div class="alert red"><b>Atención:</b> existen necesidades cuya liberación cae antes de la Semana 1.</div>'+urgents.map(u=>`<div class="alert orange"><b>${u.material}:</b> ${fmt(u.qty)} unidades para recibir en Semana ${u.week}. Lead time: ${u.lead} semana(s).</div>`).join('')}
function renderMRP(){const el=document.getElementById('mrpResults');el.innerHTML='';Object.entries(results).forEach(([name,r])=>{const rows=[['Necesidades brutas',r.gross],['Recepciones programadas',r.sched],['Inventario proyectado',r.pab],['Necesidades netas',r.net],['Recepciones planificadas',r.receipt],['Liberaciones planificadas',r.release]];el.insertAdjacentHTML('beforeend',`<div class="mrp-block"><div class="mrp-title"><h3>${name}</h3><span class="status ${r.net.some(x=>x>0)?'warn':'ok'}">${r.net.some(x=>x>0)?'REQUIERE PLANIFICACIÓN':'CUBIERTO'}</span></div><div class="table-wrap"><table><thead><tr><th>Registro</th>${Array.from({length:WEEKS},(_,i)=>`<th>Semana ${i+1}</th>`).join('')}</tr></thead><tbody>${rows.map(([label,vals])=>`<tr><td><b>${label}</b></td>${vals.map(v=>`<td>${fmt(v)}</td>`).join('')}</tr>`).join('')}</tbody></table></div></div>`)});}
function renderOrders(){const tb=document.querySelector('#ordersTable tbody');tb.innerHTML='';Object.entries(results).forEach(([name,r])=>{tb.insertAdjacentHTML('beforeend',`<tr><td><b>${name}</b></td>${r.release.map(v=>`<td>${v?fmt(v):'-'}</td>`).join('')}<td><b>${fmt(r.release.reduce((a,b)=>a+b,0))}</b></td></tr>`)});const u=document.getElementById('urgentOrders');u.innerHTML=urgents.length?urgents.map(x=>`<div class="alert red"><b>${x.material}</b>: liberar ${fmt(x.qty)} unidades antes del horizonte para recepción en Semana ${x.week}.</div>`).join(''):'<div class="alert green">No hay órdenes urgentes.</div>'}
function drawChart(){const canvas=document.getElementById('ordersChart'),dpr=window.devicePixelRatio||1,rect=canvas.parentElement.getBoundingClientRect();canvas.width=rect.width*dpr;canvas.height=rect.height*dpr;const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);const w=rect.width,h=rect.height,p={l:58,r:20,t:22,b:48};ctx.clearRect(0,0,w,h);const vals=Object.values(results).flatMap(r=>r.release),max=Math.max(100,...vals)*1.15;ctx.strokeStyle='#cbd5e1';ctx.fillStyle='#475569';ctx.font='12px Segoe UI';for(let k=0;k<=5;k++){const y=p.t+(h-p.t-p.b)*k/5;ctx.beginPath();ctx.moveTo(p.l,y);ctx.lineTo(w-p.r,y);ctx.stroke();ctx.fillText(fmt(Math.round(max*(1-k/5))),4,y+4)}const group=(w-p.l-p.r)/WEEKS,bar=Math.min(24,(group-12)/Math.max(1,materials.length));materials.forEach((m,j)=>{const r=results[m.name];if(!r)return;ctx.fillStyle=colors[j%colors.length];r.release.forEach((v,i)=>{const bh=(h-p.t-p.b)*v/max,x=p.l+i*group+(group-materials.length*bar)/2+j*bar,y=h-p.b-bh;ctx.fillRect(x,y,bar-2,bh)})});ctx.fillStyle='#334155';for(let i=0;i<WEEKS;i++)ctx.fillText('S'+(i+1),p.l+i*group+group/2-7,h-20);document.getElementById('legend').innerHTML=materials.map((m,i)=>`<span><i class="dot" style="background:${colors[i%colors.length]}"></i>${m.name}</span>`).join('')}
function applyScenario(){const f=Number(document.getElementById('scenario').value);const base=[100,150,120,180,140,160];document.querySelectorAll('.mps').forEach((x,i)=>x.value=Math.round(base[i]*f));calculate()}
function resetAll(){materials=JSON.parse(JSON.stringify(DEFAULTS));document.querySelectorAll('.mps').forEach((x,i)=>x.value=[100,150,120,180,140,160][i]);document.getElementById('scenario').value='1';renderBOM();calculate()}
function saveLocal(){const data={mps:[...document.querySelectorAll('.mps')].map(x=>n(x.value)),materials};localStorage.setItem('nodo24-otif-stock',JSON.stringify(data));alert('Escenario guardado en este navegador.')}
function loadLocal(){const raw=localStorage.getItem('nodo24-otif-stock');if(!raw)return alert('No hay un escenario guardado.');const d=JSON.parse(raw);materials=d.materials;document.querySelectorAll('.mps').forEach((x,i)=>x.value=d.mps[i]||0);renderBOM();calculate()}
function downloadCSV(){let csv='Material,Semana 1,Semana 2,Semana 3,Semana 4,Semana 5,Semana 6,Total\n';Object.entries(results).forEach(([name,r])=>csv+=`"${name}",${r.release.join(',')},${r.release.reduce((a,b)=>a+b,0)}\n`);const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='reposiciones_otif_stock.csv';a.click();URL.revokeObjectURL(a.href)}
document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.tab).classList.add('active');if(b.dataset.tab==='dashboard')setTimeout(drawChart,50)}));window.addEventListener('resize',()=>{if(document.getElementById('dashboard').classList.contains('active'))drawChart()});renderBOM();calculate();
</script>
</body>
</html>
